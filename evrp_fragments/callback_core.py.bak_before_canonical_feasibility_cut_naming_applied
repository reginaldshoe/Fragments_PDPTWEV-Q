def _v3d_record_feas_cut(full_size, cut_size, fallback, reason, cut_arcs):
    V3D_FEAS_SUMMARY["total"] += 1
    if fallback:
        V3D_FEAS_SUMMARY["fallback"] += 1
    else:
        V3D_FEAS_SUMMARY["active"] += 1
    V3D_FEAS_SUMMARY["cut_size"][int(cut_size)] += 1
    V3D_FEAS_SUMMARY["full_size"][int(full_size)] += 1
    V3D_FEAS_SUMMARY["reason"][str(reason)] += 1
    V3D_FEAS_SUMMARY["pattern"][tuple(cut_arcs)] += 1

def _v3d_print_feas_summary():
    s = V3D_FEAS_SUMMARY
    if s["total"] == 0:
        print("[V3D-FEAS-SUMMARY] total=0")
        return
    print("[V3D-FEAS-SUMMARY] total=" + str(s["total"]) + " active=" + str(s["active"]) + " fallback=" + str(s["fallback"]))
    print("[V3D-FEAS-SUMMARY] cut_size_distribution=" + str(dict(sorted(s["cut_size"].items()))))
    print("[V3D-FEAS-SUMMARY] full_size_distribution=" + str(dict(sorted(s["full_size"].items()))))
    print("[V3D-FEAS-SUMMARY] reason_distribution=" + str(dict(s["reason"].most_common())))
    print("[V3D-FEAS-SUMMARY] top_cut_patterns=" + str([(list(k), v) for k, v in s["pattern"].most_common(20)]))

atexit.register(_v3d_print_feas_summary)
