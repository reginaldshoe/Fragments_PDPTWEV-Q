def _v3a_feas_arc_seq(arcs, aid):
    """Return the SID sequence for a selected fragment arc."""
    a = arcs[aid]
    if 'seq' in a:
        return list(a['seq'])
    if 'Seq' in a:
        return list(a['Seq'])
    raise KeyError(f"Arc {aid!r} has no 'seq' or 'Seq' field; keys={list(a.keys())}")

def _v3a_feas_stitch_sid_sequence(route_arc_ids, arcs):
    """Stitch selected fragment arc SID sequences into one route SID sequence."""
    sid_seq = []
    for k, aid in enumerate(route_arc_ids):
        s = _v3a_feas_arc_seq(arcs, aid)
        if k == 0:
            sid_seq = list(s)
        elif sid_seq and s and sid_seq[-1] == s[0]:
            sid_seq.extend(s[1:])
        else:
            sid_seq.extend(s)
    return sid_seq

def _v3a_feas_skeleton_and_cover(route_arc_ids, arcs, data):
    """Build station-free skeleton and map each skeleton edge to route arc position."""
    arc_skeletons = []
    for pos, aid in enumerate(route_arc_ids):
        seq = _v3a_feas_arc_seq(arcs, aid)
        sk = [sid for sid in seq if not is_station(data, sid)]
        if sk:
            arc_skeletons.append((pos, sk))

    if not arc_skeletons:
        return [], []

    skeleton = list(arc_skeletons[0][1])
    cover_arc_index = [arc_skeletons[0][0]] * max(0, len(skeleton) - 1)

    for pos, sk in arc_skeletons[1:]:
        if not sk:
            continue
        if skeleton and skeleton[-1] == sk[0]:
            append_part = sk[1:]
        else:
            append_part = sk
        skeleton.extend(append_part)
        cover_arc_index.extend([pos] * max(0, len(append_part)))

    expected = max(0, len(skeleton) - 1)
    if len(cover_arc_index) > expected:
        cover_arc_index = cover_arc_index[:expected]
    elif len(cover_arc_index) < expected and arc_skeletons:
        cover_arc_index.extend([arc_skeletons[-1][0]] * (expected - len(cover_arc_index)))

    return skeleton, cover_arc_index

def _v3a_feas_test_chain(data, arcs, chain_arc_ids):
    """Return (ok, fail_i, skeleton) for a candidate contiguous selected-arc chain."""
    sid_seq = _v3a_feas_stitch_sid_sequence(chain_arc_ids, arcs)
    skeleton = [sid for sid in sid_seq if not is_station(data, sid)]
    if len(skeleton) < 2:
        return True, None, skeleton
    ok, _dp_dist, _dp_full_path, fail_i = dp_route_min_dist(
        data,
        skeleton,
        t0=0.0,
        E0=data['CapE'],
        max_station_visits_per_leg=DP_MAX_STATION_VISITS_PER_LEG,
        max_labels_per_node=DP_MAX_LABELS_PER_NODE,
    )
    return ok, fail_i, skeleton

def _v3a_feas_diagnose_infeasible_route(route, arcs, data, fail_i):
    """Diagnostic-only helper for infeasible DP route cases."""
    try:
        skeleton, cover_arc_index = _v3a_feas_skeleton_and_cover(route, arcs, data)
    except Exception as exc:
        print(f"[V3A-FEAS] unable to build skeleton/cover mapping: {type(exc).__name__}: {exc}")
        print(f"[V3A-FEAS] route_arc_ids={list(route)}")
        print(f"[V3A-FEAS] current whole-route cut size={len(route)}")
        return

    print("[V3A-FEAS] infeasible route detected")
    print(f"[V3A-FEAS] route_arc_ids={list(route)}")
    print(f"[V3A-FEAS] route_len={len(route)} skeleton_len={len(skeleton)} fail_i={fail_i}")

    if fail_i is None or fail_i < 0 or fail_i + 1 >= len(skeleton):
        print("[V3A-FEAS] fail_i is unavailable/out-of-range; diagnostic falls back to whole-route cut context")
        print(f"[V3A-FEAS] current whole-route cut size={len(route)}")
        return

    failed_u = skeleton[fail_i]
    failed_v = skeleton[fail_i + 1]
    print(f"[V3A-FEAS] failed_skeleton_edge={failed_u}->{failed_v}")

    if fail_i >= len(cover_arc_index):
        print(f"[V3A-FEAS] cover_arc_index missing fail_i={fail_i}; len(cover_arc_index)={len(cover_arc_index)}")
        print(f"[V3A-FEAS] current whole-route cut size={len(route)}")
        return

    covering_arc_pos = cover_arc_index[fail_i]
    if covering_arc_pos < 0 or covering_arc_pos >= len(route):
        print(f"[V3A-FEAS] covering_arc_pos out-of-range: {covering_arc_pos}; route_len={len(route)}")
        print(f"[V3A-FEAS] current whole-route cut size={len(route)}")
        return

    covering_arc_id = route[covering_arc_pos]
    prefix = list(route[:covering_arc_pos + 1])
    print(f"[V3A-FEAS] covering_arc_pos={covering_arc_pos} covering_arc_id={covering_arc_id}")
    print(f"[V3A-FEAS] current_full_route_cut_size={len(route)}")
    print(f"[V3A-FEAS] prefix_through_failure_size={len(prefix)} prefix_arc_ids={prefix}")

    best_bad = None
    tested = 0
    max_tests = min(len(prefix), V3A_FEAS_MAX_FRONT_PRUNE_TESTS)
    for start_pos in range(0, max_tests):
        candidate = list(prefix[start_pos:])
        if not candidate:
            continue
        try:
            cand_ok, cand_fail_i, cand_skeleton = _v3a_feas_test_chain(data, arcs, candidate)
        except Exception as exc:
            print(f"[V3A-FEAS] front_prune_test start_pos={start_pos} candidate_size={len(candidate)} ERROR {type(exc).__name__}: {exc}")
            continue
        tested += 1
        print(
            f"[V3A-FEAS] front_prune_test start_pos={start_pos} "
            f"candidate_size={len(candidate)} candidate_ok={cand_ok} "
            f"candidate_fail_i={cand_fail_i} candidate_skeleton_len={len(cand_skeleton)} "
            f"candidate_arc_ids={candidate}"
        )
        if not cand_ok:
            best_bad = candidate

    if best_bad is None:
        print("[V3A-FEAS] no front-pruned infeasible candidate found; current safe cut remains whole route")
    else:
        print(f"[V3A-FEAS] smallest_observed_front_pruned_bad_size={len(best_bad)}")
        print(f"[V3A-FEAS] smallest_observed_front_pruned_bad_arc_ids={best_bad}")
        print("[V3A-FEAS] diagnostic only: active lazy cut remains unchanged in v3a")
    print(f"[V3A-FEAS] front_prune_tests_run={tested}")
