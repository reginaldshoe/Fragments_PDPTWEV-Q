# --- v2b route-local optimality cut diagnostics ---

def _v2b_theta_value(model, theta):
    try:
        return float(model.cbGetSolution(theta))
    except Exception:
        return None

def _v2b_candidate_rhs(delta, M, selected_count, selected_sum_value):
    try:
        return float(delta) - float(M) * (int(selected_count) - float(selected_sum_value))
    except Exception:
        return None

def _v2b_print_route_local_optimality_candidate(model, route, choose, theta, delta, delta_total, base_route_cost, dp_dist, M):
    if not _v2a_diag_can_print(model):
        return
    route = list(route)
    choose = list(choose)
    theta_value = _v2b_theta_value(model, theta)
    route_rhs = _v2b_candidate_rhs(delta, M, len(route), float(len(route)))
    inc_rhs = _v2b_candidate_rhs(delta_total, M, len(choose), float(len(choose)))
    route_violation = None if theta_value is None or route_rhs is None else route_rhs - theta_value
    inc_violation = None if theta_value is None or inc_rhs is None else inc_rhs - theta_value
    print("\n[V2B ROUTE-LOCAL OPT CUT DIAG] candidate route-local cut")
    print("  behavioural_change: none; candidate only")
    print(f"  route_arc_ids: {route}")
    print(f"  incumbent_arc_set_S_current: {choose}")
    print(f"  base_route_cost: {base_route_cost}")
    print(f"  dp_dist: {dp_dist}")
    print(f"  route_delta: {delta}")
    print(f"  incumbent_delta_total_so_far_after_route: {delta_total}")
    print("  current_cut_form: theta >= delta_total - M * (|S_incumbent| - sum x[S_incumbent])")
    print("  candidate_cut_form: theta >= route_delta - M * (|S_route| - sum x[S_route])")
    print(f"  candidate_S_route_size: {len(route)}")
    print(f"  current_S_incumbent_size: {len(choose)}")
    print(f"  incumbent_theta_value: {theta_value}")
    print(f"  candidate_route_rhs_at_incumbent: {route_rhs}")
    print(f"  current_incumbent_rhs_at_incumbent: {inc_rhs}")
    print(f"  candidate_route_violation_at_incumbent: {route_violation}")
    print(f"  current_incumbent_violation_at_incumbent: {inc_violation}")
    print("  interpretation: candidate only; route-local S is smaller if mathematically valid\n")

def _v2b_print_final_incumbent_cut_comparison(model, choose, theta, delta_total, M):
    if not _v2a_diag_can_print(model):
