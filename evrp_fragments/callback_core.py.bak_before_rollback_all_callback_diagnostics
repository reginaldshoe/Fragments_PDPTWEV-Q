# --- v2c chain-local optimality cut diagnostics ---

def _v2c_chain_type(skeleton):
    """Classify a chain skeleton for diagnostics only."""
    if not skeleton:
        return "empty"
    start = skeleton[0]
    end = skeleton[-1]
    if start == "D0" and end == "D0":
        return "depot_to_depot"
    if start == "D0":
        return "depot_prefix"
    if end == "D0":
        return "depot_suffix"
    return "internal_customer_chain"

def _v2c_chain_base_cost(arcs, chain_arc_ids):
    total = 0.0
    for aid in chain_arc_ids:
        total += arcs[aid]["Df"]
    return total

def _v2c_dp_chain_eval(data, chain_arc_ids, arc_lookup):
    """Evaluate a contiguous chain skeleton with the existing route DP for diagnostics only."""
    skeleton, cover_arc_ids = _v2a_skeleton_and_cover(data, chain_arc_ids, arc_lookup)
    if len(skeleton) < 2:
        return {
            "ok": None,
            "dp_dist": None,
            "dp_full_path": None,
            "fail_i": None,
            "skeleton": skeleton,
            "cover_arc_ids": cover_arc_ids,
            "reason": "skeleton_has_fewer_than_two_nodes",
        }
    ok, dp_dist, dp_full_path, fail_i = dp_route_min_dist(
        data,
        skeleton,
        t0=0.0,
        E0=data["CapE"],
        max_station_visits_per_leg=DP_MAX_STATION_VISITS_PER_LEG,
        max_labels_per_node=DP_MAX_LABELS_PER_NODE,
    )
    return {
        "ok": ok,
        "dp_dist": dp_dist,
        "dp_full_path": dp_full_path,
        "fail_i": fail_i,
        "skeleton": skeleton,
        "cover_arc_ids": cover_arc_ids,
        "reason": None,
    }

def _v2c_chain_candidates(data, arcs, route, arc_lookup, max_chain_len=None):
    """Generate contiguous chain diagnostics for a selected route."""
    route = list(route)
    n = len(route)
    if max_chain_len is None:
        max_chain_len = n
    candidates = []
    for start in range(n):
        max_end = min(n, start + max_chain_len)
        for end in range(start + 1, max_end + 1):
            chain = route[start:end]
            dp = _v2c_dp_chain_eval(data, chain, arc_lookup)
            base_cost = _v2c_chain_base_cost(arcs, chain)
            dp_dist = dp["dp_dist"]
            chain_delta = None
            if dp_dist is not None:
                chain_delta = dp_dist - base_cost
            candidates.append({
                "start_pos": start,
                "end_pos_exclusive": end,
                "chain_len": len(chain),
                "chain_arc_ids": list(chain),
                "chain_type": _v2c_chain_type(dp["skeleton"]),
                "skeleton": dp["skeleton"],
                "cover_arc_ids": dp["cover_arc_ids"],
                "ok": dp["ok"],
                "fail_i": dp["fail_i"],
                "base_cost": base_cost,
                "dp_dist": dp_dist,
                "chain_delta": chain_delta,
                "dp_full_path": dp["dp_full_path"],
                "reason": dp["reason"],
            })
    return candidates

def _v2c_positive_delta_key(candidate):
    delta = candidate.get("chain_delta")
    if delta is None:
        delta = -1.0e100
    # Prefer large positive deltas, then shorter chains, then earlier chains.
    return (-delta, candidate.get("chain_len", 10**9), candidate.get("start_pos", 10**9))

def _v2c_print_chain_local_optimality_diagnostics(model, data, arcs, route, arc_lookup, route_delta, route_base_cost, route_dp_dist):
    """Print within-route contiguous-chain optimality diagnostics without applying cuts."""
    if not _v2a_diag_can_print(model):
        return
    route = list(route)
    # Keep the diagnostic bounded. For current benchmark routes this still covers all chains.
    try:
        max_chain_len = int(os.environ.get("EVRP_V2C_MAX_CHAIN_LEN", str(len(route))))
    except Exception:
        max_chain_len = len(route)
    try:
        preview_limit = int(os.environ.get("EVRP_V2C_PREVIEW_LIMIT", "8"))
    except Exception:
        preview_limit = 8
    candidates = _v2c_chain_candidates(data, arcs, route, arc_lookup, max_chain_len=max_chain_len)
    positive = [c for c in candidates if c.get("chain_delta") is not None and c["chain_delta"] > 1e-6]
    positive.sort(key=_v2c_positive_delta_key)
    smallest_positive = sorted(positive, key=lambda c: (c["chain_len"], -c["chain_delta"], c["start_pos"]))
    print("\n[V2C CHAIN-LOCAL OPT CUT DIAG] within-route chain scan")
    print("  behavioural_change: none; candidates only")
    print("  validity_status: diagnostic_only_not_proven")
    print(f"  route_arc_ids: {route}")
    print(f"  route_size: {len(route)}")
    print(f"  route_base_cost: {route_base_cost}")
    print(f"  route_dp_dist: {route_dp_dist}")
    print(f"  route_delta: {route_delta}")
    print(f"  chain_count_scanned: {len(candidates)}")
    print(f"  positive_delta_chain_count: {len(positive)}")
    print(f"  max_chain_len_scanned: {max_chain_len}")
    if positive:
        print("  top_positive_delta_chains:")
        for c in positive[:preview_limit]:
            print(
                "    "
                f"positions=[{c['start_pos']},{c['end_pos_exclusive']}) "
                f"len={c['chain_len']} type={c['chain_type']} "
                f"delta={c['chain_delta']} base={c['base_cost']} dp={c['dp_dist']} "
                f"arcs={c['chain_arc_ids']} skeleton={c['skeleton']}"
            )
        print("  smallest_positive_delta_chains:")
        for c in smallest_positive[:preview_limit]:
            print(
                "    "
                f"positions=[{c['start_pos']},{c['end_pos_exclusive']}) "
                f"len={c['chain_len']} type={c['chain_type']} "
                f"delta={c['chain_delta']} arcs={c['chain_arc_ids']} skeleton={c['skeleton']}"
            )
    else:
        print("  positive_delta_chains: none")
    print("  interpretation: use this to identify smaller within-route structures before applying any chain-local cut\n")

# --- v2d realised path chain delta diagnostics ---

def _v2d_path_distance(data, sid_path):
    """Distance along an explicit SID path, using the model distance function."""
    if sid_path is None or len(sid_path) < 2:
        return 0.0
    sid_to_i = data["sid_to_i"]
    dist_fn = data["dist"]
    total = 0.0
    for u, v in zip(sid_path[:-1], sid_path[1:]):
        total += dist_fn(sid_to_i[u], sid_to_i[v])
    return total

def _v2d_station_list(data, sid_path):
    """Stations appearing inside an explicit SID path segment."""
    return [sid for sid in sid_path if is_station(data, sid)]

def _v2d_realised_skeleton_edge_segments(skeleton, dp_full_path):
    """Map each skeleton edge to the realised subpath inside the full-route DP path."""
    skeleton = list(skeleton)
    dp_path = list(dp_full_path) if dp_full_path is not None else []
    if len(skeleton) < 2 or len(dp_path) < 2:
        return [], "missing_skeleton_or_dp_path"
    segments = []
    pos = 0
    if dp_path[0] != skeleton[0]:
        try:
            pos = dp_path.index(skeleton[0])
        except ValueError:
            return [], "skeleton_start_not_in_dp_path"
    for edge_idx, (u, v) in enumerate(zip(skeleton[:-1], skeleton[1:])):
        if pos >= len(dp_path) or dp_path[pos] != u:
            try:
                pos = dp_path.index(u, pos)
            except ValueError:
                return segments, f"edge_start_not_found:{edge_idx}:{u}"
        end_pos = None
        for j in range(pos + 1, len(dp_path)):
            if dp_path[j] == v:
                end_pos = j
                break
        if end_pos is None:
            return segments, f"edge_end_not_found:{edge_idx}:{u}->{v}"
        segment = tuple(dp_path[pos:end_pos + 1])
        segments.append({
            "edge_idx": edge_idx,
            "u": u,
            "v": v,
            "segment": segment,
            "start_pos": pos,
            "end_pos": end_pos,
        })
        pos = end_pos
    return segments, None

def _v2d_realised_arc_allocation(data, arcs, route, arc_lookup, skeleton, dp_full_path):
    """Allocate realised full-route DP distance back to selected arc ids."""
    route = list(route)
    skeleton_from_cover, cover_arc_ids = _v2a_skeleton_and_cover(data, route, arc_lookup)
    skeleton_matches = list(skeleton_from_cover) == list(skeleton)
    segments, error = _v2d_realised_skeleton_edge_segments(skeleton, dp_full_path)
    per_arc = {aid: {
        "arc_id": aid,
        "base_Df": float(arcs[aid]["Df"]),
        "realised_dp_distance": 0.0,
        "realised_delta": None,
        "edge_indices": [],
        "segments": [],
        "stations": [],
    } for aid in route}
    if error is not None:
        return {
            "skeleton_from_cover": skeleton_from_cover,
            "cover_arc_ids": cover_arc_ids,
            "skeleton_matches": skeleton_matches,
            "segments": segments,
            "per_arc": per_arc,
            "error": error,
        }
    for seg in segments:
        edge_idx = seg["edge_idx"]
        if edge_idx >= len(cover_arc_ids):
            continue
        aid = cover_arc_ids[edge_idx]
        realised = _v2d_path_distance(data, seg["segment"])
        per_arc[aid]["realised_dp_distance"] += realised
        per_arc[aid]["edge_indices"].append(edge_idx)
        per_arc[aid]["segments"].append(seg["segment"])
        per_arc[aid]["stations"].extend(_v2d_station_list(data, seg["segment"]))
    for aid in route:
        per_arc[aid]["realised_delta"] = per_arc[aid]["realised_dp_distance"] - per_arc[aid]["base_Df"]
    return {
        "skeleton_from_cover": skeleton_from_cover,
        "cover_arc_ids": cover_arc_ids,
        "skeleton_matches": skeleton_matches,
        "segments": segments,
        "per_arc": per_arc,
        "error": None,
    }

def _v2d_chain_type_from_positions(route, start, end):
    if start == 0 and end == len(route):
        return "depot_to_depot"
    if start == 0:
        return "depot_prefix"
    if end == len(route):
        return "depot_suffix"
    return "internal_chain"

def _v2d_realised_chain_candidates(route, per_arc):
    route = list(route)
    candidates = []
    n = len(route)
    for start in range(n):
        for end in range(start + 1, n + 1):
            chain = route[start:end]
            base = sum(per_arc[aid]["base_Df"] for aid in chain)
            realised = sum(per_arc[aid]["realised_dp_distance"] for aid in chain)
            delta = realised - base
            stations = []
            edge_indices = []
            for aid in chain:
                stations.extend(per_arc[aid]["stations"])
                edge_indices.extend(per_arc[aid]["edge_indices"])
            candidates.append({
                "start_pos": start,
                "end_pos_exclusive": end,
                "chain_len": len(chain),
                "chain_arc_ids": list(chain),
                "chain_type": _v2d_chain_type_from_positions(route, start, end),
                "base_cost": base,
                "realised_dp_distance": realised,
                "realised_delta": delta,
                "stations": stations,
                "edge_indices": edge_indices,
            })
    return candidates

def _v2d_print_realised_path_chain_delta_diagnostics(model, data, arcs, route, arc_lookup, skeleton, dp_full_path, route_delta, route_base_cost, route_dp_dist):
    """Print context-preserving realised DP path allocation diagnostics."""
